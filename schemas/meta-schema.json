{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeepWiki Wiki Metadata",
  "description": "Top-level metadata for a generated wiki, including per-module quality tracking.",
  "type": "object",
  "required": ["version", "generated_at", "modules"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "DeepWiki version that generated this wiki (e.g., '2.0.0')"
    },
    "cache_contract_version": {
      "type": ["string", "null"],
      "description": "Version tag for the cache contract set used during this generation run"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of wiki generation"
    },
    "last_updated": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601 timestamp of last wiki update"
    },
    "modules": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/ModuleMeta"
      },
      "description": "Per-module metadata keyed by module name"
    },
    "quality_issues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Unresolved quality issues after all generation attempts"
    },
    "failed_modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Modules that failed generation after all retries"
    },
    "stats": {
      "type": "object",
      "properties": {
        "total_modules": { "type": "integer" },
        "professional_count": { "type": "integer" },
        "standard_count": { "type": "integer" },
        "basic_count": { "type": "integer" }
      }
    }
  },
  "definitions": {
    "ModuleMeta": {
      "type": "object",
      "required": ["quality_level"],
      "properties": {
        "quality_level": {
          "enum": ["basic", "standard", "professional", null],
          "description": "Quality level of the generated module documentation"
        },
        "generated_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "updated_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    }
  }
}
