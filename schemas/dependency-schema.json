{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deepwiki.sh/schemas/dependency-schema.json",
  "title": "Dependency Analysis Output",
  "description": "Schema for AI-generated dependency analysis output (SKILL.md Step 5)",
  "type": "object",
  "required": ["core_dependencies", "architecture_layers", "reverse_dependencies"],
  "properties": {
    "core_dependencies": {
      "type": "array",
      "description": "List of important module-to-module dependencies",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["from", "to", "type", "importance"],
        "properties": {
          "from": {
            "type": "string",
            "description": "Source module or file name (without path prefix)"
          },
          "to": {
            "type": "string",
            "description": "Target module or file name"
          },
          "type": {
            "type": "string",
            "enum": ["Import", "FunctionCall", "Inheritance", "Composition", "DataFlow", "Module"],
            "description": "Type of dependency relationship"
          },
          "importance": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Importance score (5 = most important, based on dependency frequency)"
          },
          "evidence": {
            "type": "string",
            "description": "Evidence source (e.g., 'src/auth/login.py:12: from user.service import get_user')"
          },
          "description": {
            "type": "string",
            "description": "Brief explanation of why this dependency exists"
          }
        },
        "additionalProperties": false
      }
    },
    "architecture_layers": {
      "type": "array",
      "description": "Architecture layering of all components",
      "items": {
        "type": "object",
        "required": ["name", "level", "components"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Layer name (e.g., 'Presentation Layer', 'Business Logic Layer')"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "description": "Layer level (smaller = closer to infrastructure)"
          },
          "components": {
            "type": "array",
            "description": "List of component names in this layer",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "reverse_dependencies": {
      "type": "object",
      "description": "Reverse dependency mapping for incremental updates",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "key_insights": {
      "type": "array",
      "description": "Architectural observations",
      "maxItems": 10,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
