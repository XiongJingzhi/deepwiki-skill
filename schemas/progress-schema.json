{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeepWiki Pipeline Progress State",
  "description": "Tracks pipeline execution progress across workflow phases.",
  "type": "object",
  "required": ["last_updated", "phases"],
  "additionalProperties": false,
  "properties": {
    "last_updated": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601 timestamp of last progress update"
    },
    "cache_schema_version": {
      "type": "integer",
      "description": "Schema version for cache compatibility validation"
    },
    "phases": {
      "type": "object",
      "properties": {
        "overview": {
          "$ref": "#/definitions/PhaseState"
        },
        "menu": {
          "$ref": "#/definitions/PhaseState"
        },
        "analysis": {
          "type": "object",
          "description": "extract-docs module semantic analysis phase (parallel subagent dispatch)",
          "properties": {
            "status": {
              "enum": ["pending", "in_progress", "completed"]
            },
            "mode": {
              "type": "string",
              "enum": ["serial", "subagent"],
              "description": "Execution mode for this phase"
            },
            "modules": {
              "type": "object",
              "description": "Per-module analysis status",
              "additionalProperties": {
                "$ref": "#/definitions/ModuleState"
              }
            }
          }
        },
        "details": {
          "type": "object",
          "properties": {
            "status": {
              "enum": ["pending", "in_progress", "completed"]
            },
            "mode": {
              "enum": ["subagent", "serial"],
              "description": "Execution mode used for detail generation"
            },
            "modules": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/ModuleState"
              },
              "description": "Per-module progress state keyed by module name"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "PhaseState": {
      "type": "object",
      "properties": {
        "status": {
          "enum": ["pending", "in_progress", "completed"]
        },
        "started_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "completed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "ModuleState": {
      "type": "object",
      "properties": {
        "status": {
          "enum": ["pending", "in_progress", "completed", "failed"]
        },
        "quality_level": {
          "enum": ["basic", "standard", "professional"],
          "description": "Quality level after generation"
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "started_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "completed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  }
}
