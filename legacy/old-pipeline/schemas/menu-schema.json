{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeepWiki Navigation Menu",
  "description": "Schema for the wiki/menu.json navigation file generated by generate_menu.py.",
  "type": "object",
  "required": ["cache_schema_version", "title", "generated_at", "items"],
  "properties": {
    "cache_schema_version": {
      "type": "integer",
      "description": "Schema version for compatibility validation"
    },
    "title": {
      "type": "string",
      "description": "Project display name"
    },
    "version": {
      "type": ["string", "null"],
      "description": "Project version string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of menu generation"
    },
    "reconciled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this menu has been reconciled against actual wiki files"
    },
    "reconciled_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601 timestamp of last reconciliation"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/MenuGroup"
      }
    }
  },
  "definitions": {
    "MenuGroup": {
      "type": "object",
      "required": ["title", "items"],
      "properties": {
        "title": {
          "type": "string",
          "description": "Group display label (e.g., '概览', '理解项目', '能力导览', '内部实现', '参考资料', '更多')"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MenuItem"
          }
        }
      }
    },
    "MenuItem": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {
          "type": "string",
          "description": "Item display label (from file's first H1 heading)"
        },
        "path": {
          "type": "string",
          "description": "Relative path from wiki/ directory (e.g., 'capabilities/core.md')"
        },
        "planned": {
          "type": "boolean",
          "default": false,
          "description": "Whether this item represents a planned but not yet generated document"
        },
        "items": {
          "type": "array",
          "description": "Nested items for rare explicit submenu groups. Default DeepWiki pages should be one menu item per Markdown file.",
          "items": {
            "$ref": "#/definitions/MenuItem"
          }
        }
      }
    }
  }
}
